# AnyGet — common commands. Run `make help` for the list.
SHELL := /bin/bash
API := apps/api
UV := uv run --project $(API)
# Downloads are owned by you, not root (read by docker-compose.yml).
export PUID ?= $(shell id -u)
export PGID ?= $(shell id -g)

.DEFAULT_GOAL := help
.PHONY: cli-docs notices help setup dev dev-api dev-web gen gen-api gen-check lint format typecheck test check e2e live build up down logs ps up-public backup restore extension release-check

help: ## Show this help
	@grep -E '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

setup: ## Install all dependencies (uv + pnpm)
	uv sync --project $(API)
	pnpm install
	@test -f .env || cp .env.example .env

dev: ## Run api (:8000) and web (:3000) with reload
	@trap 'kill 0' EXIT; $(MAKE) dev-api & $(MAKE) dev-web & wait

dev-api:
	cd $(API) && uv run uvicorn anyget.main:app --reload --host 127.0.0.1 --port 8000

dev-web:
	pnpm --filter @anyget/web dev

gen: ## Regenerate packages/shared from the API OpenAPI schema
	pnpm gen

gen-api: gen ## Same as `make gen`

gen-check: gen ## Fail if the generated client is out of date
	git diff --exit-code -- packages/shared

lint: ## ruff + eslint + prettier
	cd $(API) && uv run ruff check . && uv run ruff format --check .
	pnpm lint
	pnpm format:check

format: ## Auto-format Python and TypeScript
	cd $(API) && uv run ruff format . && uv run ruff check --fix .
	pnpm format

typecheck: ## mypy strict + tsc
	cd $(API) && uv run mypy anyget tests
	pnpm typecheck

test: ## pytest + vitest (+ the example plugin)
	cd $(API) && uv run pytest
	cd examples/anyget-plugin-example && uv run pytest -q
	pnpm test

backup: ## Back up data/ (database, settings, cookies) to backups/
	cd $(API) && ANYGET_DATA_DIR=$(CURDIR)/data uv run anyget backup create --out $(CURDIR)/backups

restore: ## Restore a backup: make restore FILE=backups/anyget-….tar.gz (stop AnyGet first)
	@test -n "$(FILE)" || (echo "Usage: make restore FILE=backups/anyget-....tar.gz" && exit 1)
	@if docker compose ps --status running --services 2>/dev/null | grep -qx api; then \
		echo "AnyGet is running. Stop it first: make down"; exit 1; fi
	cd $(API) && ANYGET_DATA_DIR=$(CURDIR)/data uv run anyget backup restore $(abspath $(FILE))

extension: ## Build the browser extension (apps/extension/dist/*.zip)
	pnpm --filter @anyget/extension build

check: lint typecheck test ## lint + typecheck + test

cli-docs: ## Regenerate docs/cli.md from the Typer CLI
	cd $(API) && uv run typer anyget.cli.main utils docs --name anyget --title "AnyGet command line" --output ../../docs/cli.md
	sed -i '2i\\n<!-- Generated by `make cli-docs` from the Typer CLI; edit the commands in apps/api/anyget/cli/, not this file. -->' docs/cli.md

notices: ## Regenerate the dependency tables in THIRD_PARTY_NOTICES.md
	uv run --project $(API) python scripts/third_party_notices.py

e2e: ## Playwright + axe (starts api and web itself)
	pnpm e2e

live: ## Live network tests (YouTube, Vimeo) in the Docker test image with ffmpeg + Deno
	docker compose --profile test run --rm --build api-test

build: ## Build Docker images
	docker compose build

up: ## Start api + web with Docker Compose
	@mkdir -p downloads data
	docker compose up -d --build
	@echo "AnyGet is starting at http://127.0.0.1:3000"

down: ## Stop containers
	docker compose down

logs: ## Follow container logs
	docker compose logs -f

ps: ## Show container status and health
	docker compose ps

up-public: ## Start with Cloudflare Tunnel (needs TUNNEL_TOKEN in .env)
	@mkdir -p downloads data
	docker compose -f docker-compose.yml -f docker-compose.tunnel.yml up -d --build
