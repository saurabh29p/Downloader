# AnyGet settings. Copy this file to .env (`cp .env.example .env`) and change only what you need.
# Every line is optional on your own computer; the defaults below are safe. Never commit .env.
# Values saved on AnyGet's Settings and Connections pages win over the ones in this file.

# ----- Basics -----------------------------------------------------------------------------------
# Contact email sent in the User-Agent to archive.org and other public APIs (be a polite client).
ANYGET_CONTACT_EMAIL=
# Host user and group ids that own downloaded files (`make up` fills these in for you).
# PUID=1000
# PGID=1000

# ----- Downloads --------------------------------------------------------------------------------
# Folders for `make dev` (Docker always uses ./downloads and ./data next to docker-compose.yml).
ANYGET_DOWNLOADS_DIR=./downloads
ANYGET_DATA_DIR=./data
# Remove downloaded files after this many days; 0 (the default) keeps them forever (Settings → Downloads).
ANYGET_RETENTION_DAYS=0
# Downloads that run at once, in total and per site.
ANYGET_MAX_CONCURRENT_DOWNLOADS=3
ANYGET_MAX_PER_HOST=4
# Speed limit for each download in KiB/s (0 = no limit).
ANYGET_RATE_LIMIT_KBPS=0
# Sub-folders for new downloads, e.g. {type}/{source} (also {year} {month} {title}); empty = none.
ANYGET_FOLDER_TEMPLATE=
# Check watched channels, playlists and collections on their schedule.
ANYGET_WATCH_ENABLED=true
# Torrents (magnet links) are off by default; they also need the optional libtorrent (`uv sync --extra torrent`).
ANYGET_TORRENT_ENABLED=false
# Keep sharing a torrent after it finishes.
ANYGET_TORRENT_SEED=false
# OCR in the Docker image reads English, Hindi and Arabic; 1 adds Japanese, Chinese, French, German, Spanish and Russian (~150 MB).
ANYGET_WITH_OCR=0

# ----- Hosting and sign-in (needed when AnyGet can be reached from the internet: docs/hosted.md) --
# Owner sign-in email. With no owner, a public AnyGet refuses every request (it fails closed).
ANYGET_OWNER_EMAIL=
# Password hash from `docker compose run --rm api anyget hash-password`; in this file write each $ as $$.
ANYGET_OWNER_PASSWORD_HASH=
# Signs the sign-in cookie (any long random string); empty = a key is made once in data/session.key.
ANYGET_SESSION_SECRET=
# Days a sign-in lasts.
ANYGET_SESSION_DAYS=30
# true when AnyGet is on the internet and no hosting platform (Railway and others) is detected.
ANYGET_PUBLIC=false
# Bearer token for the CLI, the browser extension and scripts: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANYGET_API_TOKEN=
# auto: this computer needs nothing and remote requests need sign-in, Access or the token; always: every request does.
ANYGET_AUTH_MODE=auto
# Cloudflare Access team domain (e.g. myteam.cloudflareaccess.com) and the application's AUD tag (docs/deploy.md).
ANYGET_ACCESS_TEAM_DOMAIN=
ANYGET_ACCESS_AUD=
# Cloudflare Tunnel token for `make up-public` (Zero Trust → Networks → Tunnels → your tunnel → Docker).
TUNNEL_TOKEN=
# Requests per minute from each remote client, and writes per minute.
ANYGET_RATE_LIMIT_PER_MINUTE=600
ANYGET_RATE_LIMIT_WRITES_PER_MINUTE=60

# ----- Connections (all free; easier on the Connections page, which stores them encrypted) -------
# Encrypts saved Connections: `anyget gen-key`; empty = a key is made once in data/secrets.key (changing it loses saved ones).
ANYGET_SECRETS_KEY=
# GitHub token: higher API limits for code downloads.
ANYGET_GITHUB_TOKEN=
# Hugging Face and Civitai tokens: gated models you accepted, higher limits.
ANYGET_HF_TOKEN=
ANYGET_CIVITAI_TOKEN=
# Kaggle username and API key: datasets.
ANYGET_KAGGLE_USERNAME=
ANYGET_KAGGLE_KEY=
# Free keys for library and book APIs (Europeana, DPLA, Trove, DigitalNZ, Biodiversity Heritage Library, Deutsche Digitale Bibliothek).
ANYGET_EUROPEANA_KEY=
ANYGET_DPLA_KEY=
ANYGET_TROVE_KEY=
ANYGET_DIGITALNZ_KEY=
ANYGET_BHL_KEY=
ANYGET_DDB_KEY=
# TMDB key or token for Movies ("where to watch"); also read as TMDB_API_KEY.
ANYGET_TMDB_KEY=

# ----- AI helper (optional: everything works without it, and it never sees cookies, keys or files)
# OpenRouter key; also read as OPENROUTER_API_KEY.
ANYGET_OPENROUTER_KEY=
# Use only free ":free" models (also a switch in Settings → AI helper).
ANYGET_LLM_FREE_MODE=false
# AI calls per day (0 turns the helper off).
ANYGET_LLM_DAILY_LIMIT=500
# Model lists, comma separated, most preferred first; empty = the built-in lists.
ANYGET_LLM_ROUTER_MODELS=
ANYGET_LLM_SUMMARY_MODELS=

# ----- Advanced ---------------------------------------------------------------------------------
# Where `anyget health` looks for the API (Docker publishes 127.0.0.1:8000).
ANYGET_HOST=127.0.0.1
ANYGET_PORT=8000
# Timeout in seconds for each outgoing request.
ANYGET_REQUEST_TIMEOUT=30
# Proxy for every outgoing request (http://host:port or socks5://host:port); HTTP(S)_PROXY is ignored on purpose.
ANYGET_PROXY=
# Per-site download limits as JSON, replacing the built-in ones (archive.org and big libraries: 2).
# ANYGET_HOST_LIMITS={"archive.org": 2}
# Plugins to load, comma separated ("*" = all installed). Plugins are code: install only ones you trust.
ANYGET_PLUGINS=
# Limit the book sources and the universal search sources, comma separated (empty = all).
ANYGET_BOOK_SOURCES=
ANYGET_UNIVERSAL_SOURCES=
# Gutendex address (Project Gutenberg search; it can be self-hosted).
ANYGET_GUTENDEX_URL=https://gutendex.com
# Sent to OpenRouter as HTTP-Referer: it names the app, not you.
ANYGET_APP_URL=https://github.com/saurabh29p/Downloader
# Only for tests: host:port pairs allowed to reach private addresses. Never set this in normal use.
ANYGET_NET_ALLOWLIST=
