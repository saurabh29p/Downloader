# Copy to .env and fill in. Never commit .env.
# Nothing here is required for local use. Hosted (Railway, a VPS, a tunnel): the owner
# sign-in below is required; see docs/hosted.md for which variable goes where.

# Where files and the SQLite database live (host paths, mounted into the api container)
ANYGET_DOWNLOADS_DIR=./downloads
ANYGET_DATA_DIR=./data

# Retention: downloaded files older than this many days are removed (0 = keep forever).
# The first removals happen this many days after it is switched on; files tagged "keep"
# and running downloads are never removed. Also editable in Settings → Downloads.
ANYGET_RETENTION_DAYS=7

# Host user and group ids that own downloaded files (make up fills these in for you)
# PUID=1000
# PGID=1000

# Contact email sent in the User-Agent to archive.org and other APIs (be a polite client)
ANYGET_CONTACT_EMAIL=

# Owner sign-in (required when AnyGet is on the internet: Railway, a VPS, a tunnel…).
# Make the hash with `uv run anyget hash-password` (in apps/api). In this file, write
# each $ of the hash as $$ (Docker Compose reads $ as a variable).
ANYGET_OWNER_EMAIL=
ANYGET_OWNER_PASSWORD_HASH=
# Signs the session cookie (long and random). Empty: a key is made in data/session.key.
ANYGET_SESSION_SECRET=
# Encrypts saved Connections (cookies, keys): `uv run anyget gen-key`. Empty: a key is
# made once in data/secrets.key. Changing it makes saved connections unreadable.
ANYGET_SECRETS_KEY=
# Set to true when AnyGet is reachable from the internet and no platform is detected.
# ANYGET_PUBLIC=false

# Access from outside this computer (docs/deploy.md).
# Bearer token for the CLI, the browser extension and scripts (long and random:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))")
ANYGET_API_TOKEN=
# Cloudflare Access: your team domain and the application's AUD tag (Zero Trust →
# Access → Applications → AnyGet → Overview). Requests through the tunnel need both.
ANYGET_ACCESS_TEAM_DOMAIN=
ANYGET_ACCESS_AUD=
# auto: this computer needs nothing, the tunnel needs Access or the token.
# always: every request needs Access or the token.
ANYGET_AUTH_MODE=auto

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker)
TUNNEL_TOKEN=

# Optional keys. Every one is free; leave empty to skip that source.
# Code and AI hosts (higher limits, gated repos you accepted)
ANYGET_GITHUB_TOKEN=
ANYGET_HF_TOKEN=
ANYGET_CIVITAI_TOKEN=
ANYGET_KAGGLE_USERNAME=
ANYGET_KAGGLE_KEY=
# Movies (where to watch) and the optional AI helper; also settable in Connections
TMDB_API_KEY=
OPENROUTER_API_KEY=
# The AI helper's daily call limit (0 turns it off) and model overrides (comma separated).
# Free mode (only ":free" models) can also be switched on in Settings → AI helper.
ANYGET_LLM_DAILY_LIMIT=500
# ANYGET_LLM_FREE_MODE=false
# ANYGET_LLM_ROUTER_MODELS=google/gemini-2.5-flash-lite,openai/gpt-5-nano
# ANYGET_LLM_SUMMARY_MODELS=google/gemini-3.1-flash-lite,deepseek/deepseek-v3.2
# Books and libraries
ANYGET_EUROPEANA_KEY=
ANYGET_DPLA_KEY=
ANYGET_TROVE_KEY=
ANYGET_DIGITALNZ_KEY=
ANYGET_BHL_KEY=
ANYGET_DDB_KEY=

# OCR for English, Hindi and Arabic is always in the API image. 1 = add Japanese, Chinese,
# French, German, Spanish and Russian (about 150 MB more)
ANYGET_WITH_OCR=0
